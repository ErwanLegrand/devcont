[package]
name = "{{project_name}}"
version = "0.1.0"
edition = "2024"
description = "{{project_description}}"
authors = ["Erwan Patrick Legrand <github@erwanlegrand.com>"]
license = "Apache-2.0 OR MIT"
repository = "{{repository_url}}"
keywords = ["rust"]
categories = ["rust-patterns"]
homepage = "{{repository_url}}"
documentation = "{{repository_url}}"
readme = "README.md"

[dependencies]
# Error handling
thiserror = "2.0"

# Serialization
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"

# Logging and observability
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }

# Async runtime (optional - uncomment if needed)
# tokio = { version = "1.0", features = ["full"] }

[dev-dependencies]
# Testing utilities
proptest = "1.0"
criterion = "0.5"

# Benchmarking (uncomment when you add benchmarks)
# [[bench]]
# name = "benchmarks"
# harness = false

[build-dependencies]
# Build-time dependencies if needed

[features]
default = []
# Add feature flags as needed
# full = ["tokio/full"]